# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL (untuk halaman share /s/<slug> + tombol Bagikan)
VITE_CONVEX_SITE_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Origin frontend untuk redirect halaman share /s/<slug> (Convex backend env).
# Setel via: bunx convex env set SITE_URL https://sumenepkerja.com
# SITE_URL=http://localhost:5173 (untuk dev lokal)
