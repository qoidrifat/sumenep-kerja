# ============================================================
# Contoh konfigurasi environment — salin ke .env.local
# dan isi nilainya. JANGAN commit file .env.local.
# ============================================================

# --- Frontend (dibaca Vite, HARUS berawalan VITE_) ---

# Convex deployment URL — jalankan `npx convex dev` untuk mendapatkannya.
VITE_CONVEX_URL=

# Origin situs untuk halaman share /s/<slug> + tombol Bagikan (tanpa trailing slash).
VITE_CONVEX_SITE_URL=https://sumenepkerja.com

# Nomor WhatsApp admin tujuan klaim/verifikasi mitra (LOW-5 audit).
# Tanpa tanda +, contoh: 6281234567890
VITE_ADMIN_WHATSAPP_NUMBER=

# --- Convex backend (setel lewat `bunx convex env set <KEY> <nilai>`,
#     BUKAN lewat file ini) ---

# ⚠️ LOW-3 audit — PENTING:
# CONVEX_SITE_URL dipakai auth.config.ts sebagai DOMAIN PROVIDER OIDC
# (issuer + endpoint discovery `${domain}/.well-known/openid-configuration`).
# Jangan isi http://localhost:5173 — sign-in akan gagal permanen.
# Isi dengan origin produksi tempat auth HTTP routes dilayani:
CONVEX_SITE_URL=https://sumenepkerja.com

# Deployment yang dipakai `npx convex dev` (kosongkan bila tidak dipakai).
CONVEX_DEPLOYMENT=

# Backend lainnya (setel via convex env):
#   SITE_URL              — origin frontend untuk halaman share (share.ts)
#   EMAIL_API_KEY         — API key layanan OTP email (CRIT-2 audit)
#   ADMIN_PASSCODE_HASH   — SHA-256 hex dari passphrase dashboard admin
#                           (CRIT-3 audit; JANGAN menyimpan passphrase mentah)
#   VLY_CONVEX_AUTH_ISSUER— issuer token federasi Freebuff
#
# Contoh membuat ADMIN_PASSCODE_HASH:
#   echo -n "passphrase-anda" | shasum -a 256
